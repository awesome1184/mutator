{
  "private": true,
  "name": "mutator-daily",
  "version": "2.0.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:web": "vite build --config vite.standalone.config.ts",
    "dev": "devvit playtest",
    "dev:web": "vite --config vite.standalone.config.ts",
    "deploy": "npm run type-check && npm run test:unit && devvit upload",
    "launch": "npm run deploy && devvit publish",
    "login": "devvit login",
    "type-check": "tsc --build",
    "test:unit": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test \"tests/*.test.ts\"",
    "audit:days": "node --experimental-strip-types --no-warnings=ExperimentalWarning tools/audit-days.ts",
    "audit:pairs": "node --experimental-strip-types --no-warnings=ExperimentalWarning tools/audit-pairs.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@devvit/start": "0.15.6",
    "@devvit/web": "0.15.6",
    "@fontsource-variable/archivo": "5.3.0",
    "@hono/node-server": "2.1.6",
    "devvit": "0.15.6",
    "hono": "4.13.17",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "6.0.3",
    "vite": "8.3.7"
  }
}
