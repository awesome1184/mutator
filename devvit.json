{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "mutator-daily",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "splash.html",
        "height": "tall"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "redis": true,
    "reddit": {
      "enable": true,
      "scope": "user"
    }
  },
  "menu": {
    "items": [
      {
        "label": "MUTATOR: post today's puzzle",
        "description": "Creates (or opens) today's daily MUTATOR post",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-today"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onAppUpgrade": "/internal/triggers/on-app-upgrade"
  },
  "scheduler": {
    "tasks": {
      "daily-post": {
        "endpoint": "/internal/scheduler/daily-post",
        "cron": "1 0 * * *"
      },
      "prepare-tomorrow": {
        "endpoint": "/internal/scheduler/prepare-tomorrow",
        "cron": "17 * * * *"
      }
    }
  },
  "marketingAssets": {
    "icon": "assets/icon.png"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  }
}
